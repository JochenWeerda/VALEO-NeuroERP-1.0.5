# VALEO NeuroERP Frontend - Desktop Development Dockerfile
# Optimiert für lokale Entwicklung mit Hot Reload

FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./

# Install dependencies with optimizations for development
RUN npm ci --only=production=false --cache /tmp/.npm

# Copy source code
COPY . .

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose development port
EXPOSE 3000

# Health check for development
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000 || exit 1

# Development command with hot reload
CMD ["npm", "start"]
